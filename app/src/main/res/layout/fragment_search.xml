<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    tools:context=".SearchFragment">

    <EditText
        android:id="@+id/editText_search"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/corners_radius_background"
        android:fontFamily="@font/roboto_medium"
        android:hint="@string/search..."
        android:inputType="text"
        android:maxLength="80"
        android:paddingLeft="20dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textColor="@color/grey"
        android:textSize="12sp"
        android:imeOptions="actionDone"
        app:layout_constraintBottom_toTopOf="@+id/button_search_select_category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_search_select_category"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"

        android:background="@android:color/transparent"
        android:drawableRight="@drawable/arrow_18px"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center|start"
        android:padding="0dp"
        android:text="@string/select_category"
        android:textSize="14sp"
        app:iconPadding="0dp"
        app:layout_constraintBottom_toTopOf="@+id/button_search_filters"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editText_search" />

    <Button
        android:id="@+id/button_search_filters"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"

        android:background="@android:color/transparent"
        android:drawableRight="@drawable/arrow_18px"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center|start"
        android:padding="0dp"
        android:text="@string/filters"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_search_select_category" />
</androidx.constraintlayout.widget.ConstraintLayout>